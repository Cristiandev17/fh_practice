---
import MainLayout from "@layouts/MainLayout.astro";
import Title from "@components/shared/Title.astro";
import { Counter } from "@components/Counter.tsx";

const counterValue = 20;
---

<MainLayout title="Favoritos">
  <Title>Islas</Title>

  <div style={{ height: "2000px", opacity: 0.5, backgroundColor: "red" }}></div>
  <Counter client:load initialValue={counterValue}>
    <Title>Counter Islas</Title>
  </Counter>
</MainLayout>
