---
interface Props {
    name:string;
    url:string;
    isBig?:boolean;
}

const { name, url, isBig = false} = Astro.props;
const id = url.split('/').at(-2);
const imageSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
console.log(imageSrc)
---

<a 
 href={`/pokemons/${name}`}
 aria-label="Pokemon Card" class="p-2 rounded border-2 border-slate-600 flex flex-col justify-center items-center">
	<img src={imageSrc} alt={name}>
    <span class="text-lg font-bold capitalize">#{id}{name}</span>
</a>